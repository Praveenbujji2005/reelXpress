# ==============================================================================
# reelXpress Application Environment Variables Template
# Copy this file to .env.local and populate with your credentials
# ==============================================================================

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="reelXpress"
NEXT_PUBLIC_WHATSAPP_NUMBER=918431912122

# ==============================================================================
# Firebase Configuration
# Obtain these from: https://console.firebase.google.com/
# Project Settings > General > Your Apps > Web App Configuration
# ==============================================================================
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKeyHere"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="reelxpress-app.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="reelxpress-app"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="reelxpress-app.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
NEXT_PUBLIC_FIREBASE_DATABASE_URL="https://reelxpress-app-default-rtdb.firebaseio.com"

# ==============================================================================
# Admin Credentials & Security (Initial administrator account)
# ==============================================================================
ADMIN_DEFAULT_EMAIL="admin@reelxpress.com"
ADMIN_DEFAULT_PASSWORD="ReelXpress@Admin2026!"
ADMIN_SECRET_KEY="replace_with_strong_random_secret_token"
